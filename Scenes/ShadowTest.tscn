[sub_resource type="Shader" id="Shader_mgg1t"]
code = "shader_type spatial;
render_mode cull_disabled;

#include \"res://addons/dynamic_lightmap_shadows/DynamicShadows.gdshaderinc\"

varying vec3 worldPos;
varying vec3 n;

uniform int bitmask;


void fragment() {
    ALBEDO = vec3(1.0);
	float shadow = get_orthogonal_shadow(worldPos, n, bitmask, FRAGCOORD);
	ALBEDO = mix(ALBEDO, ALBEDO * shadow_color, shadow);
}

void vertex(){
	worldPos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	n = (MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz;
}"

